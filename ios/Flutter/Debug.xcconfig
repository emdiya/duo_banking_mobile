#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Use the simulator SDK architectures and build only the selected destination.
// Device and Release/Profile architecture settings remain unchanged.
ARCHS[sdk=iphonesimulator*] = $(ARCHS_STANDARD)
ONLY_ACTIVE_ARCH[sdk=iphonesimulator*] = YES
